{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "vercel-build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "build": "tsc",
    "test": "node --require ts-node/register --test src/continuacoes.test.ts src/deals/deals.test.ts src/detetiveCinemaFlags.test.ts src/ingressoClient.test.ts src/ingressoPageParser.test.ts src/filmeAntecipacao.test.ts src/calendarBr.test.ts src/filmeLancamentoTags.test.ts src/crunchyrollStatus.test.ts src/crunchyrollCms.test.ts src/listaService.test.ts scripts/test-mais-esperados.fixture.test.ts scripts/streaming-providers.test.ts",
    "dev": "nodemon src/index.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:deploy": "node scripts/prisma-deploy.js",
    "release": "npx prisma migrate deploy && npm run build",
    "sync": "cross-env LOG_TO_FILE=true ts-node src/sync.ts",
    "sync:2026": "cross-env LOG_TO_FILE=true ts-node src/sync.ts 2026-01-01 2026-12-31",
    "sync:movies": "cross-env LOG_TO_FILE=true ts-node src/syncMovies.ts",
    "sync:series": "cross-env LOG_TO_FILE=true ts-node src/syncSeries.ts",
    "sync:animes": "cross-env LOG_TO_FILE=true ts-node src/syncAnimes.ts",
    "cleanup:adult-animes": "ts-node src/purgeAdultAnimes.ts",
    "sync:games": "cross-env LOG_TO_FILE=true ts-node src/syncGames.ts",
    "sync:awards": "cross-env LOG_TO_FILE=true ts-node src/scrapeAwards.ts",
    "sync:detetive": "cross-env LOG_TO_FILE=true ts-node src/detetive.ts",
    "sync:full": "cross-env LOG_TO_FILE=true SYNC_RUNNER=github-actions ts-node src/runFullSyncCli.ts",
    "cache:invalidate": "bash ../scripts/invalidate-cache.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "moviedb-promise": "^4.0.7",
    "node-cron": "^4.2.1",
    "prisma": "^5.14.0",
    "puppeteer": "^24.23.1",
    "string-similarity": "^4.0.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/string-similarity": "^4.0.2",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.0.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "author": "",
  "license": "ISC"
}
