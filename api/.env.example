# API Express (api/)
PORT=3001
NODE_ENV=production

# Postgres (Supabase: use connection pooler for DATABASE_URL)
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Auth / sync
JWT_SECRET=change-me-to-a-long-random-string
SYNC_SECRET=change-me-sync-secret
# Sem JWT_SECRET/SYNC_SECRET/IGDB_WEBHOOK_SECRET configurados o servidor recusa subir.
# Só pra dev local sem esses secrets prontos:
# ALLOW_INSECURE_DEV_SECRETS=true

# Redis (Upstash: use Redis URL rediss:// — não REST https://)
REDIS_URL=

# Health detalhado (opcional): header x-health-token em /api/health
HEALTH_CHECK_TOKEN=

# Supabase (projeto remoto — use .env.local para valores reais)
# Dashboard: "Publishable key" (sb_publishable_...) → *_ANON_KEY
# Dashboard: "Secret key" (sb_secret_...) → SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# APIs externas
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Webhooks IGDB (opcional). Mantém jogos já sincronizados atualizados sem depender só do
# sync por polling. PUBLIC_API_URL precisa ser a URL pública do próprio serviço (ex.: a URL
# do Render), pois a IGDB usa isso para montar a callback que ela chama.
IGDB_WEBHOOKS_ENABLED=false
IGDB_WEBHOOK_SECRET=
PUBLIC_API_URL=
# Log de sync em arquivo (produção) + buffer em memória para GET /api/sync/logs
SYNC_LOG_TO_FILE=false
# Keep-alive durante sync (evita hibernação no Render free). RENDER_EXTERNAL_URL é injetado pelo Render.
# SYNC_KEEPALIVE_URL=https://orbe-7bu0.onrender.com
# SYNC_KEEPALIVE_INTERVAL_MS=600000
STEAM_API_KEY=

# Promoções — IsThereAnyDeal (Epic + EA pagas em BRL). Registre um app em https://isthereanydeal.com/apps/
ITAD_API_KEY=
# ITAD_COUNTRY=BR
# ITAD_MAX_PAGES=10

# CORS (origens do frontend — separadas por vírgula)
CORS_ORIGIN=https://orbe-seven.vercel.app,http://localhost:3000
