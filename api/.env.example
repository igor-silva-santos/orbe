# API Express (api/)
PORT=3001
NODE_ENV=production

# Postgres (Supabase: use connection pooler for DATABASE_URL)
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Auth / sync
JWT_SECRET=change-me-to-a-long-random-string
SYNC_SECRET=change-me-sync-secret

# Redis (Upstash: use Redis URL rediss:// — não REST https://)
REDIS_URL=

# Health detalhado (opcional): header x-health-token em /api/health
HEALTH_CHECK_TOKEN=

# Supabase (projeto remoto — use .env.local para valores reais)
# Dashboard: "Publishable key" (sb_publishable_...) → *_ANON_KEY
# Dashboard: "Secret key" (sb_secret_...) → SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# APIs externas
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_API_KEY=

# CORS (origens do frontend — separadas por vírgula)
CORS_ORIGIN=https://orbe-seven.vercel.app,http://localhost:3000
