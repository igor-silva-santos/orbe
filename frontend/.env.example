# Frontend Next.js (frontend/)
# O proxy /api → API Express é configurado em next.config.mjs (rewrites).
# Em produção na Vercel, defina UMA das opções abaixo:

# Opção A — URL completa da API (origem derivada automaticamente para o proxy)
NEXT_PUBLIC_API_URL=https://YOUR-API-HOST.example.com/api

# Opção B — origem da API sem /api (alternativa à opção A)
# API_PROXY_ORIGIN=https://YOUR-API-HOST.example.com

# WebSocket — host da API (com ou sem /api/ws; o app normaliza)
NEXT_PUBLIC_WS_URL=wss://YOUR-API-HOST.example.com

NEXT_PUBLIC_APP_URL=https://orbe-seven.vercel.app

# Supabase (opcional — auth/storage)
# No dashboard Supabase, "Publishable key" = NEXT_PUBLIC_SUPABASE_ANON_KEY abaixo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
