{
  "manifest_version": 3,
  "name": "Orbe Nerd · Crunchyroll",
  "version": "0.2.0",
  "description": "Sincroniza a fila da Crunchyroll com o Orbe (organizador do que assistir a seguir).",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://*.crunchyroll.com/*",
    "http://localhost:3001/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Orbe · Crunchyroll",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*/watchlist*",
        "https://www.crunchyroll.com/watchlist*"
      ],
      "js": ["content/crunchyroll-watchlist.js"],
      "run_at": "document_idle"
    }
  ]
}
